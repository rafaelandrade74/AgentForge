# AgentForge — configuração. Copie para .env e ajuste:  cp .env.example .env
# Para gerar segredos aleatórios de uma vez: ./scripts/init-env.sh (Linux/macOS) ou ./scripts/init-env.ps1 (Windows)

# ---- Obrigatório: troque antes de expor o sistema fora da sua máquina ---------------------------------
# Usuário administrador criado no primeiro start (a senha fica só como hash BCrypt)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# Chave de assinatura dos JWT: mínimo de 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars

# Senha do Postgres. O banco só lê isso ao ser criado: se trocar depois, recrie o volume (docker compose down -v)
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=change-me

# ---- Banco de dados: subir o Postgres do compose é opcional ------------------------------------------
# Padrão: o compose sobe o próprio Postgres (profile "local-db").
COMPOSE_PROFILES=local-db
# Para usar um Postgres que você já tem: deixe COMPOSE_PROFILES vazio (o db não sobe) e defina a string de conexão Npgsql.
# O banco e o usuário precisam existir; as tabelas são criadas sozinhas no start. POSTGRES_* deixam de ser usados.
# DATABASE_URL=Host=meu-postgres;Port=5432;Database=agentforge;Username=agentforge;Password=troque

# ---- Agentes -----------------------------------------------------------------------------------------
# Claude Code (único agente do MVP). Nada a configurar aqui na maioria dos casos: abra a tela "Agentes" da
# aplicação, veja se já está conectado, teste e, se precisar, entre pelo link (sem chave de API).
# Opcional: uma chave de API da Anthropic em vez do login de conta.
ANTHROPIC_API_KEY=

# Reaproveitar o login que JÁ existe no seu computador (modo Docker com o CLI no container): aponte para a pasta
# ~/.claude do computador. Só funciona se o login estiver em arquivo (Windows/Linux). Leia o README antes.
# CLAUDE_CONFIG_SOURCE=C:/Users/voce/.claude

# Usar o claude/git instalados NO COMPUTADOR (modo 1): rode ./scripts/host-agent.ps1 (ou .sh); ele preenche estes dois.
# Depois: docker compose -f docker-compose.yml -f docker-compose.host-agent.yml up -d --build
# HOST_AGENT_TOKEN=
# HOST_WORKSPACES_ROOT=
# HOST_AGENT_URL=http://host.docker.internal:8787

# Versão do CLI instalada na imagem (fixa de propósito; para atualizar, mude e rode docker compose up -d --build)
CLAUDE_CODE_VERSION=2.1.316

# Quantas tarefas andam ao mesmo tempo. Com mais de 1, Tech Lead e Security revisam em paralelo.
ORCHESTRATOR_CONCURRENCY=1

# ---- Rede --------------------------------------------------------------------------------------------
# Porta do front (o único serviço exposto). A API só aparece em 127.0.0.1:API_DEBUG_PORT, para depuração.
WEB_PORT=8080
API_DEBUG_PORT=8081

# Documentação interativa da API em /swagger (os endpoints continuam exigindo login). false para esconder.
SWAGGER_ENABLED=true

# Agentes podem instalar dependências (apt, outro Node, Python...) com sudo DENTRO do container da API (ADR 0016).
# Para endurecer: AGENT_SUDO=false e API_NO_NEW_PRIVILEGES=true, depois docker compose up -d --build api.
#AGENT_SUDO=true
#API_NO_NEW_PRIVILEGES=false
