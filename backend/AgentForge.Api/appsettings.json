{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=agentforge;Username=agentforge;Password="
  },
  "Auth": {
    "JwtSecret": "",
    "Issuer": "agentforge",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "LoginAttemptsPerMinute": 10,
    "AdminUsername": "admin",
    "AdminPassword": ""
  },
  "Agents": {
    "Launcher": "local",
    "HostAgent": {
      "Url": "",
      "Token": ""
    }
  },
  "Workspaces": {
    "Root": "/data/repos"
  },
  "Orchestrator": {
    "MaxConcurrency": 1
  },
  "GitHub": {
    "ApiUrl": "https://api.github.com"
  },
  "Swagger": {
    "Enabled": true
  },
  "Frontend": {
    "Path": ""
  }
}
